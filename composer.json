{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trademinator/bcmath",
    "type": "library",
    "description": "Framework-agnostic BCMath helpers and precision utilities for PHP.",
    "keywords": [
        "bcmath",
        "decimal",
        "precision",
        "math"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Trademinator\\BcMath\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trademinator\\BcMath\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
